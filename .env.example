# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY CONFIGURATION (Server-Side Only)
# Get these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# RAZORPAY WEBHOOK SECRET (Server-Side Only)
# Set in Razorpay Dashboard -> Settings -> Webhooks (Endpoint: /api/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# RESEND EMAIL SERVICE (Server-Side Only)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Knot Just Krochet <onboarding@resend.dev>"

# PORT (Optional for custom server runtime, default 3000)
PORT=3000
