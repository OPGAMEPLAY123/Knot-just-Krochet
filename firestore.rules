rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'opgstudiosofficial@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Customer Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isValidId(userId) && (
        (isOwner(userId) && incoming().uid == existing().uid) ||
        isAdmin()
      );
      allow delete: if isValidId(userId) && isAdmin();

      // Customer Personal Wishlist
      match /wishlist/{wishlistId} {
        allow get, list, create, update, delete: if isValidId(userId) && isValidId(wishlistId) && isOwner(userId);
      }
    }

    // Products Catalogue
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId) && isAdmin();
      allow update: if isValidId(productId) && isAdmin();
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) && isAdmin();
      allow update: if isValidId(categoryId) && isAdmin();
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Customer Orders
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Custom Order Inquiries
    match /customOrderRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(requestId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isValidId(requestId) && isAdmin();
      allow delete: if isValidId(requestId) && isAdmin();
    }

    // Store Settings & Policies
    match /storeSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isValidId(settingId) && isAdmin();
    }

    // Authorized Admins
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }
  }
}
